{
  "name": "savr-wiki",
  "version": "1.0.0",
  "private": true,
  "description": "SAVR_WIKI — the Savage Rebels (SAVR) alliance knowledge base for Last Asylum: Plague. Events, field guides, strategies, AvA scoring, an event calendar with local instant search, and a leadership-friendly CMS, built as a static Next.js site.",
  "scripts": {
    "dev": "npm run build:search && next dev",
    "build": "npm run build:search && next build",
    "build:search": "node scripts/build-search-index.mjs",
    "heroes:import": "node scripts/import-heroes.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "preview": "serve out -l 4173",
    "decap": "decap-server",
    "assets": "node scripts/generate-brand-assets.mjs && node scripts/generate-logo-assets.mjs && node scripts/generate-assets.mjs",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "assets:logo": "node scripts/generate-logo-assets.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "next-mdx-remote": "^6.0.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.3",
    "serve": "^14.2.4",
    "sharp": "^0.34.1",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3"
  }
}
