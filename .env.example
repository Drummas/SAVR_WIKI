NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Reserved for the future Supabase-backed member portal.
# Do not place a service-role key in a client-exposed variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reserved for future Discord announcements. Server-side only; never expose.
DISCORD_WEBHOOK_URL=
